# Copiar como .env y completar. El archivo .env NO se sube al repositorio.
# Datos de conexión: Supabase > Project Settings > Database.
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=
DB_PASSWORD=
DB_SSLMODE=require

# Django (backend-admin). DEBUG es False por defecto: en desarrollo local poner True.
# Con DJANGO_DEBUG=False la DJANGO_SECRET_KEY es obligatoria (50+ caracteres aleatorios, SECRETA).
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Clave para firmar los JWT (Spring Boot). Mínimo 32 caracteres aleatorios.
JWT_SECRET=

# Supabase Storage (H4): licencias de funcionamiento en el bucket privado "licencias".
# Supabase > Project Settings > API Keys. La secret key es SECRETA: solo en .env.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET_LICENCIAS=licencias

# Correo (H12, H17, H20) por SMTP de Resend.
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
# API key de Resend (empieza con re_). Es SECRETA: solo en .env.
MAIL_PASSWORD=
MAIL_FROM=BotiCompara <notificaciones@boticompara.nissidev.dev>

# Alerta de stock bajo (H12): por defecto todos los dias a las 8:00 (hora de Lima). Solo cambiar para pruebas.
# ALERTA_STOCK_CRON=0 0 8 * * *
# Mientras se desarrolla, ALERTA_STOCK_HABILITADA=false evita enviar el aviso diario.
# ALERTA_STOCK_HABILITADA=false

# URL publica del backend, usada en los enlaces de los correos (H20). Por defecto http://localhost:8080/api
# APP_BASE_URL=http://localhost:8080/api

# Consulta del RUC en SUNAT (H2) con Decolecta. El token es SECRETO: solo en .env.
# Sin token, el RUC solo se valida localmente.
RUC_API_URL=https://api.decolecta.com/v1/sunat/ruc
RUC_API_TOKEN=

# Asistente con Gemini (H68). Cada integrante usa su propia clave de Google AI Studio. La clave es SECRETA:
# solo en .env. Sin clave la API arranca igual, pero POST /chat responde 503. Ver docs/API.md, sección 8.
GEMINI_API_KEY=
GEMINI_MODEL=
# Límites propios del chat (opcionales). Por defecto: 3 por minuto y 15 por día por usuario, y 150 por día en total.
# chat.limite.por-minuto=3
# chat.limite.por-dia=15
# chat.limite.global-por-dia=150