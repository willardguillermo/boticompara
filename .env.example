# Copiar como .env y completar. El archivo .env NO se sube al repositorio.
# Datos de conexión: Supabase > Project Settings > Database.
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=
DB_PASSWORD=
DB_SSLMODE=require

# Clave para firmar los JWT (Spring Boot). Mínimo 32 caracteres aleatorios.
JWT_SECRET=

# Supabase Storage (H4): licencias de funcionamiento en el bucket privado "licencias".
# Supabase > Project Settings > API Keys. La secret key es SECRETA: solo en .env.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET_LICENCIAS=licencias

# Correo (H12, H17, H20). En desarrollo usar un sandbox de Mailtrap.
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@boticompara.local

# Alerta de stock bajo (H12): por defecto todos los dias a las 8:00 (hora de Lima). Solo cambiar para pruebas.
# ALERTA_STOCK_CRON=0 0 8 * * *