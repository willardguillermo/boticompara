# Copiar como .env y completar. El archivo .env NO se sube al repositorio.
# Datos de conexión: Supabase > Project Settings > Database.
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=
DB_PASSWORD=
DB_SSLMODE=require

# Clave para firmar los JWT (Spring Boot). Mínimo 32 caracteres aleatorios.
JWT_SECRET=

# Supabase Storage (H4): subir licencias al bucket privado "licencias".
# Supabase > Project Settings > API. La service role key es SECRETA: solo en .env.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Correo saliente (H6, H12, H17, H20). Gmail del proyecto con contraseña de aplicación.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
